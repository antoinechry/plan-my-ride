{
  "name": "sillage-app",
  "version": "0.1.0",
  "private": true,
  "description": "Sillage — app iPhone et Android (Capacitor) construite à partir de index.html",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "build:test": "node scripts/build-www.mjs --test",
    "sync": "node scripts/build-www.mjs && cap sync",
    "sync:test": "node scripts/build-www.mjs --test && cap sync",
    "icons": "node scripts/make-icon-sources.mjs && capacitor-assets generate --android --ios --iconBackgroundColor '#14201b' --iconBackgroundColorDark '#14201b' --splashBackgroundColor '#14201b' --splashBackgroundColorDark '#121b17'",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "leaflet": "^1.9.4",
    "sharp": "^0.35.5"
  }
}
