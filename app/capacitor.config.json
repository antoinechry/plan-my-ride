{
  "appId": "cc.sillage.app",
  "appName": "Sillage",
  "webDir": "www",
  "server": {
    "hostname": "app.sillage-ride.eu",
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "android": {
    "backgroundColor": "#14201b"
  },
  "ios": {
    "backgroundColor": "#14201b",
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchFadeOutDuration": 0,
      "backgroundColor": "#14201b",
      "showSpinner": false
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": true,
        "facebook": false,
        "twitter": false
      },
      "logLevel": 1
    }
  }
}
